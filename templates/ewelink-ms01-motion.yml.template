name: ewelink-ms01-motion
components:
  - id: main
    capabilities:
      - id: motionSensor
        version: 1
      - id: battery
        version: 1
      - id: buildbook37604.driverInformation
        version: 1
      - id: refresh
        version: 1
    categories:
      - name: MotionSensor
preferences:
  - name: motionInterval
    title: 감지 유지시간
    description: 모션 감지 후 감지 없음으로 변경할 시간을 선택합니다. 센서 자체의 하드웨어 재감지 주기는 변경되지 않을 수 있습니다.
    required: true
    preferenceType: enumeration
    definition:
      options:
        "5": 5초
        "10": 10초
        "15": 15초
        "30": 30초
        "60": 1분
        "120": 2분
        "180": 3분
        "300": 5분
      default: "60"
